{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/tool/:name", "destination": "https://harshu-pande-ratecommons-api.hf.space/api/tool/:name" },
    { "source": "/api/tools", "destination": "https://harshu-pande-ratecommons-api.hf.space/api/tools" },
    { "source": "/api/health", "destination": "https://harshu-pande-ratecommons-api.hf.space/api/health" },
    { "source": "/api/status", "destination": "https://harshu-pande-ratecommons-api.hf.space/api/status" },
    { "source": "/mcp", "destination": "https://harshu-pande-ratecommons-api.hf.space/mcp" },
    { "source": "/mcp/", "destination": "https://harshu-pande-ratecommons-api.hf.space/mcp/" },
    { "source": "/gradio_api/mcp/", "destination": "https://harshu-pande-ratecommons-api.hf.space/gradio_api/mcp/" },
    { "source": "/data/shop/:path*", "destination": "https://harshu-pande-ratecommons-api.hf.space/data/shop/:path*" },
    { "source": "/((?!api/|ocr/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob: https://server.arcgisonline.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ocr/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
